rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/(default)/documents/admins/$(request.auth.uid);
    }

    function isActiveAdmin() {
      return signedIn()
        && firestore.exists(adminPath())
        && firestore.get(adminPath()).data.active == true
        && firestore.get(adminPath()).data.email == request.auth.token.email;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /menu-items/{allPaths=**} {
      allow read: if true;
      allow create, update: if isActiveAdmin() && isValidImageUpload();
      allow delete: if isActiveAdmin();
    }

    match /package-images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isActiveAdmin() && isValidImageUpload();
      allow delete: if isActiveAdmin();
    }
  }
}
