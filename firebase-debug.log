[debug] [2026-05-14T04:21:39.065Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/kabab-hut-catering/rulesets {"name":"projects/kabab-hut-catering/rulesets/7d9b428f-026b-4bbd-b899-c3c1b59c2866","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function adminPath() {\n      return /databases/$(database)/documents/admins/$(request.auth.uid);\n    }\n\n    function isActiveAdmin() {\n      return signedIn()\n        && exists(adminPath())\n        && get(adminPath()).data.active == true\n        && get(adminPath()).data.email == request.auth.token.email;\n    }\n\n    match /admins/{adminId} {\n      allow read: if signedIn() && (request.auth.uid == adminId || isActiveAdmin());\n      allow create, update, delete: if isActiveAdmin();\n    }\n\n    match /orders/{orderId} {\n      allow create: if signedIn()\n        && request.resource.data.userId == request.auth.uid;\n      allow read: if isActiveAdmin()\n        || (signedIn() && resource.data.userId == request.auth.uid);\n      allow update: if isActiveAdmin();\n      allow delete: if false;\n    }\n\n    match /users/{userId} {\n      allow read, create, update: if isActiveAdmin()\n        || (signedIn() && request.auth.uid == userId);\n      allow delete: if false;\n    }\n\n    match /menuItems/{itemId} {\n      allow read: if true;\n      allow create, update, delete: if isActiveAdmin();\n    }\n\n    match /packages/{packageId} {\n      allow read: if true;\n      allow create, update, delete: if isActiveAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-14T04:21:39.048735Z","metadata":{"services":["cloud.firestore"]}}
